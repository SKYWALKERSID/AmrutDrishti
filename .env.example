# JalDrishti Environment Configuration Example
# Copy this file to .env.local for local development.

# Application Settings
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional private local Python model service. Never expose the token to the browser.
JALDRISHTI_MODEL_SERVICE_URL=http://127.0.0.1:8081
JALDRISHTI_MODEL_SERVICE_PORT=8081
JALDRISHTI_MODEL_SERVICE_TOKEN=replace-with-a-local-random-token

# Supabase Authentication & Database Integration (Placeholders)
# Find these in your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here-NEVER-EXPOSE-TO-BROWSER

# Earth Observation & Geospatial Providers (Placeholders)
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# Groundwater & Weather Data API Tokens (Placeholders)
INDIA_WRIS_API_KEY=your_india_wris_api_token_here
IMD_DATA_SERVICE_TOKEN=your_imd_token_here

# Advisory dispatch is simulated unless all production gates are explicitly enabled.
# Never enable live dispatch for a prototype or test deployment.
DLT_SMS_API_KEY=your_sms_gateway_api_key
DLT_ENTITY_ID=your_trai_registered_entity_id
DLT_SENDER_ID=JALDRS
DLT_GATEWAY_URL=https://api.sms.gov.in/send
JALDRISHTI_ENABLE_LIVE_SMS_DISPATCH=false
