# JalDrishti Environment Configuration Example
# Copy this file to .env.local for local development.

# Application Settings
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Earth Observation & Geospatial Providers (Placeholders)
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# Groundwater & Weather Data API Tokens (Placeholders)
INDIA_WRIS_API_KEY=your_india_wris_api_token_here
IMD_DATA_SERVICE_TOKEN=your_imd_token_here

# SMS & WhatsApp Messaging Gateway (Placeholders)
SMS_GATEWAY_PROVIDER=nic_dlt
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key
WHATSAPP_BUSINESS_API_TOKEN=your_whatsapp_token
