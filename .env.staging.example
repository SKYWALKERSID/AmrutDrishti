# ========================================================
# Jal Drishti — Staging Environment Variables Template
# ========================================================
# IMPORTANT: Use placeholders only. Never commit real secrets.

# 1. Private Python Model Serving
# Bounded to internal container/host port. Must NOT be accessible on 0.0.0.0
JALDRISHTI_MODEL_SERVICE_URL=http://model-serving:8081
JALDRISHTI_MODEL_SERVICE_PORT=8081

# Minimum 32-character high-entropy secret token for inter-service Bearer authentication
JALDRISHTI_MODEL_SERVICE_TOKEN=staging_placeholder_token_minimum_32_characters_random

# 2. Next.js Application Environment
NODE_ENV=production
PORT=3000

# 3. Client Invariant Guarantee:
# Ensure that NO internal tokens or model URLs are prefixed with NEXT_PUBLIC_
